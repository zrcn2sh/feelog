/// 앱 설정 및 API 키 관리
/// dart-define으로 주입하는 방식 예시.
/// 실제 app_secret.dart는 String.fromEnvironment를 사용합니다.
///
/// 예)
/// flutter run --dart-define=GEMINI_API_KEY=your_key --dart-define=GOOGLE_WEB_CLIENT_ID=your_web_client_id
/// flutter build appbundle --release --dart-define=GEMINI_API_KEY=your_key --dart-define=GOOGLE_WEB_CLIENT_ID=your_web_client_id
class AppSecret {
  static const String _geminiApiKey =
      String.fromEnvironment('GEMINI_API_KEY', defaultValue: '');

  static const String _googleWebClientId =
      String.fromEnvironment('GOOGLE_WEB_CLIENT_ID', defaultValue: '');

  static String get geminiApiKey {
    if (_geminiApiKey.isEmpty) {
      throw StateError('GEMINI_API_KEY가 설정되지 않았습니다.');
    }
    return _geminiApiKey;
  }

  static String get googleWebClientId {
    if (_googleWebClientId.isEmpty) {
      throw StateError('GOOGLE_WEB_CLIENT_ID가 설정되지 않았습니다.');
    }
    return _googleWebClientId;
  }
}
